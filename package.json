{
  "name": "latam-payouts-mvp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @latam-payouts/api --filter @latam-payouts/web dev",
    "stack:start": "bash ./scripts/start-stack.sh",
    "stack:restart": "bash ./scripts/restart-stack.sh",
    "localnet:validator": "solana-test-validator --ledger apps/api/.localnet/ledger --reset",
    "localnet:setup": "pnpm --filter @latam-payouts/api localnet:setup",
    "testnet:setup": "pnpm --filter @latam-payouts/api testnet:setup",
    "demo:reset": "pnpm --filter @latam-payouts/api demo:reset",
    "localnet:dbpush": "pnpm --filter @latam-payouts/api prisma:push:localnet",
    "localnet:smoke": "pnpm --filter @latam-payouts/api localnet:smoke",
    "localnet:e2e": "pnpm --filter @latam-payouts/api localnet:e2e",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
