PORT=4000
JWT_SECRET=super-secret-change-me

SOLANA_CLUSTER="testnet"
SOLANA_RPC_URL="https://api.testnet.solana.com"

# Do not commit real private keys. Prefer a local Solana CLI keypair path.
# The setup script also accepts SOLANA_PRIVATE_KEY as a JSON secret-key array for CI only.
TESTNET_DEPLOYER_KEYPAIR="/absolute/path/to/solana-testnet-deployer.json"

# Optional: use your browser wallet as the whitelisted funding wallet.
# If omitted, setup-testnet generates apps/api/.testnet/keys/company.json and mints mock USDC to it.
TESTNET_COMPANY_WALLET="REPLACE_WITH_WALLET_THAT_WILL_SIGN_FUNDING"

FUNDING_WATCH_ENABLED="true"
FUNDING_WATCH_INTERVAL_MS="3000"
FUNDING_PERSISTENCE_MODE="memory"
